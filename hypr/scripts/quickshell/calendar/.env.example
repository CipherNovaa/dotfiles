# OpenWeather credentials for the calendar weather widget. Copy to .env (same folder).
# Get a free key at https://home.openweathermap.org/api_keys
# Find your city id at https://openweathermap.org (open your city, the id is in the URL).
OPENWEATHER_KEY=your-api-key-here
OPENWEATHER_CITY_ID=0000000
OPENWEATHER_UNIT=metric
