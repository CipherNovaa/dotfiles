[Unit]
Description=Run the CRT at 59.94 Hz while a Dolphin game is on it (dolphin-crt60d)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 %h/scripts/system/dolphin-crt60d.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
